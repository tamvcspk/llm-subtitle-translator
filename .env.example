# Web console account - REQUIRED on the first run. Without both values (and no account stored
# yet) the console and API answer 503 (the queue worker keeps running). They only seed the
# account: afterwards change the password in Settings. Login is not encrypted: keep the
# port on your LAN or put it behind a reverse proxy with TLS.
CONSOLE_USER=admin
CONSOLE_PASSWORD=replace-me
# Forgot the password? Set to 1 with the two values above, restart once, then remove it.
CONSOLE_PASSWORD_RESET=
# Set to "off" ONLY to run the console without authentication on a trusted network.
CONSOLE_AUTH=
# Leave empty ("strict") unless the console runs in an iframe of ANOTHER site (Organizr on another host). Then set "none"
# AND serve the console over HTTPS through a proxy that sends X-Forwarded-Proto: https (browsers drop the cookie otherwise).
CONSOLE_COOKIE_SAMESITE=

# API keys SEED the worker on its FIRST run only. They are then stored in its database and
# managed in the web console (Settings): changing or removing them here later has no effect.
# To replace a key, paste the new one in Settings; it is used at once, with no restart.
GEMINI_API_KEY=replace-me
GEMINI_API_KEY1=

# Optional second Gemini key, used when the first key's quota is spent or the key is refused.
GEMINI_API_KEY2=

# Optional: run the models on an OpenAI-compatible server (OpenRouter, Ollama, LM Studio, vLLM)
# instead of Gemini. Both are only the default until a provider is saved in Settings. Set the
# model names too (GST_MODEL, and the strong model in Settings): the Gemini defaults do not exist
# on those servers. LLM_API_KEY seeds the key on the first run; a server of your own needs none.
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=

# Optional but recommended. Used only to build better translation context.
TMDB_API_KEY=

# Bazarr URL as seen from this worker container.
# Use http://bazarr:6767 if both containers share a Docker network, or a LAN URL.
BAZARR_URL=http://bazarr:6767

# Optional (a seed like the keys above). If omitted, the worker tries to read it from mounted
# Bazarr config.yaml.
BAZARR_API_KEY=

# FFmpeg is optional for SRT-only translation.
# Set true only if you later add worker-side audio/video extraction.
INSTALL_FFMPEG=false

# Published image used by docker compose pull.
GST_BAZARR_IMAGE=ghcr.io/tamvcspk/llm-subtitle-translator:latest

# Host paths used by docker-compose.yml.
MEDIA_ROOT=/mnt/data
BAZARR_CONFIG_DIR=/opt/docker/bazarr/config
# Only the old queue folder inside it is read, once, to settle an older queue into the database.
BAZARR_POSTPROCESS_DIR=/opt/docker/bazarr/postprocess
WORKER_STATE_DIR=/opt/docker/gemini-srt-translator-bazarr

# Translation options. GST_MODEL is the default until a model is saved in Settings.
GST_MODEL=gemini-3.1-flash-lite
GST_TARGET_LANGUAGE=Vietnamese
# Guard for trying the worker against a real Bazarr: only translate under these folders (it limits
# your requests and the auto-request policy alike). Leave empty for normal operation.
# GST_ONLY_PATHS=/media/Series/Some Show
# Per API key request limits; 0 = unlimited. Default RPM is 10 (free tier) unless
# "paid quota" is enabled in the Settings page.
# LLM_RPM=10
# LLM_TPM=0
# LLM_RPD=0

# Worker/runtime options.
WORKER_SLEEP_SECONDS=15
HTTP_TIMEOUT_SECONDS=20
