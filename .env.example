# Web console login (HTTP Basic Auth) - REQUIRED. Without both values the console and
# API answer 503 (the queue worker keeps running). Basic Auth is not encrypted: keep the
# port on your LAN or put it behind a reverse proxy with TLS.
CONSOLE_USER=admin
CONSOLE_PASSWORD=replace-me
# Set to "off" ONLY to run the console without authentication on a trusted network.
CONSOLE_AUTH=

# Optional initial values. These can also be configured in the web console.
GEMINI_API_KEY=replace-me
GEMINI_API_KEY1=

# Optional second Gemini key, used when the first key's quota is spent or rejected.
GEMINI_API_KEY2=

# Optional but recommended. Used only to build better translation context.
TMDB_API_KEY=

# Bazarr URL as seen from this worker container.
# Use http://bazarr:6767 if both containers share a Docker network, or a LAN URL.
BAZARR_URL=http://bazarr:6767

# Optional. If omitted, the worker tries to read it from mounted Bazarr config.yaml.
BAZARR_API_KEY=

# FFmpeg is optional for SRT-only translation.
# Set true only if you later add worker-side audio/video extraction.
INSTALL_FFMPEG=false

# Published image used by docker compose pull.
GST_BAZARR_IMAGE=ghcr.io/tamvcspk/llm-subtitle-translator:latest

# Host paths used by docker-compose.yml.
MEDIA_ROOT=/mnt/data
BAZARR_CONFIG_DIR=/opt/docker/bazarr/config
BAZARR_POSTPROCESS_DIR=/opt/docker/bazarr/postprocess
WORKER_STATE_DIR=/opt/docker/gemini-srt-translator-bazarr

# Translation options.
GST_MODEL=gemini-3.1-flash-lite
GST_TARGET_LANGUAGE=Simplified Chinese
# Guards for trying the worker against a real Bazarr (also set them in the Bazarr container so
# the enqueue script obeys them): only translate under these folders, and never keep more than
# this many jobs waiting. Leave empty / 0 for normal operation.
# GST_ONLY_PATHS=/media/Series/Some Show
# GST_MAX_PENDING=3
# Per API key request limits; 0 = unlimited. Default RPM is 10 (free tier) unless
# "paid quota" is enabled in the Settings page.
# LLM_RPM=10
# LLM_TPM=0
# LLM_RPD=0

# Worker/runtime options.
WORKER_SLEEP_SECONDS=15
HTTP_TIMEOUT_SECONDS=20
